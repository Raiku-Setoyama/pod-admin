# Application
PROJECT_NAME=POD Admin API
VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pod_admin

# Security
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HEADER=X-API-Key

# CORS
CORS_ORIGINS=["http://localhost:3000","https://pod-admin-beige.vercel.app"]

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=104857600

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CONTACT_EMAIL=
